# ==============================================================================
# SafeSpace SSFRMS — Environment Configuration Template (.env.example)
# ==============================================================================
# SAU ĐÂY LÀ DANH SÁCH BIẾN MÔI TRƯỜNG CHO BACKEND / DOCKER / STAGING / PRODUCTION.
# KHÔNG COMMIT FILE .env THẬT HOẶC CÁC KHÓA BÍ MẬT VÀO GIT REPOSITORY.
# ==============================================================================

# ─── 1. Môi trường ASP.NET Core ───────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
# Port nội bộ container ASP.NET Core lắng nghe
ASPNETCORE_URLS=http://+:8080

# ─── Container Image References (Ghim bằng digest hoặc tag trên registry) ────
API_IMAGE=ghcr.io/ryocoding13/ssfrms/api:latest
WEB_IMAGE=ghcr.io/ryocoding13/ssfrms/web:latest
MIGRATOR_IMAGE=ghcr.io/ryocoding13/ssfrms/migrator:latest
API_DIGEST=ghcr.io/ryocoding13/ssfrms/api:latest
WEB_DIGEST=ghcr.io/ryocoding13/ssfrms/web:latest
MIGRATOR_DIGEST=ghcr.io/ryocoding13/ssfrms/migrator:latest

# ─── 2. Kết nối Cơ sở Dữ liệu (SQL Server) ──────────────────────────────────
# Mật khẩu SA cho container SQL Server
SA_PASSWORD=YourStrong!Password2026
MSSQL_SA_PASSWORD=YourStrong!Password2026

# Chuỗi kết nối SQL Server (dùng cho API và one-shot Migrator)
DATABASE_CONNECTION_STRING=Server=sqlserver,1433;Database=SSFRMS;User Id=sa;Password=YourStrong!Password2026;TrustServerCertificate=True;
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=SSFRMS;User Id=sa;Password=YourStrong!Password2026;TrustServerCertificate=True;

# ─── 3. Quản lý Migration và Seeding ──────────────────────────────────────────
# Production MẶC ĐỊNH: AutoMigrate=false (chạy qua migrator bundle riêng biệt), SeedMode=None
Database__AutoMigrate=false
SEED_MODE=None
Database__SeedMode=None
# Mật khẩu khởi tạo admin một lần khi bootstrap hệ thống mới (tùy chọn)
ADMIN_INITIAL_PASSWORD=SetAStrongAdminPasswordHere!

# ─── 4. JWT & Xác thực ────────────────────────────────────────────────────────
# BẮT BUỘC: Secret phải là chuỗi ngẫu nhiên tối thiểu 32 ký tự, an toàn
JWT_SECRET=CHANGE_ME_TO_A_SECURE_256BIT_KEY_AT_LEAST_32_CHARS_LONG!!
JwtSettings__Secret=CHANGE_ME_TO_A_SECURE_256BIT_KEY_AT_LEAST_32_CHARS_LONG!!
JwtSettings__Issuer=SSFRMSApi
JwtSettings__Audience=SSFRMSClients
JwtSettings__ExpiryMinutes=1440

# Khóa sinh mã QR mở cửa kho (nếu không đặt sẽ dùng chung JwtSettings__Secret)
AccessQr__Secret=
AccessQr__DenyOverdue=true

# ─── 5. Cổng thanh toán PayOS ─────────────────────────────────────────────────
# Lấy từ https://my.payos.vn/ (kênh thanh toán của SafeSpace)
PAYOS_CLIENT_ID=YOUR_PAYOS_CLIENT_ID
PAYOS_API_KEY=YOUR_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=YOUR_PAYOS_CHECKSUM_KEY
PayOS__ClientId=YOUR_PAYOS_CLIENT_ID
PayOS__ApiKey=YOUR_PAYOS_API_KEY
PayOS__ChecksumKey=YOUR_PAYOS_CHECKSUM_KEY

# ─── 6. URL Frontend và CORS ──────────────────────────────────────────────────
# URL public của Frontend (dùng cho PayOS redirect return & cancel URL)
FRONTEND_URL=https://safespace.vn
AppSettings__FrontendUrl=https://safespace.vn
# Cổng public Nginx/Web trên host
STAGING_PORT=8080
PROD_PORT=8080
# Danh sách Origin được phép truy cập CORS qua API (nếu có cross-origin)
Cors__AllowedOrigins__0=https://safespace.vn
# Cors__AllowedOrigins__1=https://staging.safespace.vn
