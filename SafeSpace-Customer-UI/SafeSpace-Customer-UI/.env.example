# Chép thành .env.local rồi chỉnh.

# Nối backend SSFRMS (StorageProject.Api). false = chạy bằng dữ liệu lưu trong trình duyệt.
VITE_USE_API=true
VITE_API_URL=http://localhost:5151

# Thời gian giữ đơn chờ chuyển khoản (giây). Figma: 01:00 → 60. Dùng 900 cho 15 phút.
VITE_PAYMENT_TIMEOUT_SECONDS=60

# Tài khoản nhận chuyển khoản, dùng để tạo mã VietQR ở màn thanh toán (C04)
VITE_BANK_BIN=970422
VITE_BANK_NAME=MB Bank
VITE_BANK_ACCOUNT=0901234567890
VITE_BANK_HOLDER=CONG TY TNHH SAFESPACE
