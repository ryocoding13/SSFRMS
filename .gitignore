# ============================================================
# SafeSpace SSFRMS — Root .gitignore
# ============================================================

# ─── .NET Backend ───────────────────────────────────────────
bin/
obj/
*.user
*.suo
.vs/
*.rsuser
*.DotSettings.user
*.openapi.json

# Sensitive appsettings — keep appsettings.json, exclude dev overrides with secrets
appsettings.Development.json
appsettings.*.json
!appsettings.json

# Entity Framework migration snapshots (track if desired; exclude if team manages manually)
# **/Migrations/

# .NET publish output
publish/
**/bin/
**/obj/

# ─── Node / Frontend ────────────────────────────────────────
node_modules/
dist/
build/
.cache/
.parcel-cache/

# Vite / TypeScript
*.tsbuildinfo
vite.config.*.timestamp-*

# Environment files — exclude secrets, keep example
.env.local
.env.production
.env.staging
# Keep committed:
# .env           ← contains only VITE_API_URL, no secrets
# .env.example

# ─── OS & Editor ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*-old/
SafeSpace-Customer-UI-old/

# ─── Logs ───────────────────────────────────────────────────

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Misc ───────────────────────────────────────────────────
*.zip
*.tar.gz
